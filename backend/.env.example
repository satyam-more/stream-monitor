# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=telemetry_db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Alert Thresholds
ALERT_TEMP_THRESHOLD=50
